ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  InfiniteStamp_config = debug

else ifeq ($(config),release)
  InfiniteStamp_config = release

else ifeq ($(config),emscriptenrelease)
  InfiniteStamp_config = emscriptenrelease

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := InfiniteStamp

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

InfiniteStamp:
ifneq (,$(InfiniteStamp_config))
	@echo "==== Building InfiniteStamp ($(InfiniteStamp_config)) ===="
	@${MAKE} --no-print-directory -C build -f Makefile config=$(InfiniteStamp_config)
endif

clean:
	@${MAKE} --no-print-directory -C build -f Makefile clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
