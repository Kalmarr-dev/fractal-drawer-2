ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  FractalDrawer2_config = debug

else ifeq ($(config),release)
  FractalDrawer2_config = release

else ifeq ($(config),emscriptenrelease)
  FractalDrawer2_config = emscriptenrelease

else ifeq ($(config),singlethreadedrelease)
  FractalDrawer2_config = singlethreadedrelease

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := FractalDrawer2

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

FractalDrawer2:
ifneq (,$(FractalDrawer2_config))
	@echo "==== Building FractalDrawer2 ($(FractalDrawer2_config)) ===="
	@${MAKE} --no-print-directory -C build -f Makefile config=$(FractalDrawer2_config)
endif

clean:
	@${MAKE} --no-print-directory -C build -f Makefile clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  release"
	@echo "  emscriptenrelease"
	@echo "  singlethreadedrelease"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   FractalDrawer2"
	@echo ""
